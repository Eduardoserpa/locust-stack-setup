# Docker Compose Environment Variables for Matrix Stack with Locust and OpenTelemetry
# This file configures all three services: Synapse, Locust, and OpenTelemetry Collector

# ===========================
# Synapse Configuration
# ===========================
SYNAPSE_SERVER_NAME=matrix.local
SYNAPSE_REPORT_STATS=no
SYNAPSE_CONFIG_DIR=/conf
SYNAPSE_CONFIG_PATH=/conf/homeserver.yaml
SYNAPSE_DATA_VOLUME=./data/synapse
SYNAPSE_UID=1000
SYNAPSE_GID=1000

# Database settings
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=654321

# Synapse ports
SYNAPSE_PORT=8008
SYNAPSE_METRICS_PORT=9090

# Synapse secrets (generate with: openssl rand -hex 32)
MACAROON_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ===========================
# Matrix Locust Configuration
# ===========================
LOCUST_USERS=100
LOCUST_SPAWN_RATE=5
LOCUST_RUN_TIME=10m
LOCUST_PORT=8089
LOCUST_HOST=http://synapse:8008
LOCUST_HEADLESS=false
LOCUST_AUTOSTART=false

# ===========================
# OpenTelemetry Collector Configuration
# ===========================
OTEL_COLLECTOR_HOST=otel-collector
OTEL_COLLECTOR_PORT_GRPC=4317
OTEL_COLLECTOR_PORT_HTTP=4318

# Service name and resource attributes
OTEL_SERVICE_NAME=matrix-stack
OTEL_RESOURCE_ATTRIBUTES=service.name=matrix-stack,service.namespace=local,service.version=1.0

# ===========================
# Jaeger Configuration (for trace visualization)
# ===========================
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1
JAEGER_PORT=16686

# ===========================
# PostgreSQL Configuration
# ===========================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ===========================
# Redis Configuration
# ===========================
REDIS_HOST=redis
REDIS_PORT=6379

# ===========================
# Container Image Versions
# ===========================
SYNAPSE_IMAGE=matrixdotorg/synapse:latest
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
LOCUST_BASEIMAGE=python:3.11-slim

# ===========================
# Data Volumes
# ===========================
POSTGRES_DATA_VOLUME=./data/postgres
REDIS_DATA_VOLUME=./data/redis

# ===========================
# Logging Configuration
# ===========================
LOG_LEVEL=INFO
LOGS_DRIVER=json-file
LOGS_MAX_SIZE=5m
LOGS_MAX_FILE=2
